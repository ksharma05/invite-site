# Copy to .env.local and fill in real values. Never commit .env.local.
# Server-only variables: none of these may be prefixed with NEXT_PUBLIC_.

# fixture = development placeholder content; sheets = Google Sheets (Phase 5, not wired yet)
CONTENT_SOURCE=fixture

# Set to "true" ONLY to allow placeholder fixtures in a production build (e.g. a preview deploy).
ALLOW_FIXTURE_CONTENT=false

# Required only when CONTENT_SOURCE=sheets (Phase 5). Placeholders shown here.
GOOGLE_SHEETS_SPREADSHEET_ID=<spreadsheet-id>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account-email>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=<service-account-private-key>

# Optional. How often the server re-fetches the spreadsheet, in seconds. Default 60.
SHEETS_REVALIDATE_SECONDS=60

# Durable last-known-good snapshot (Phase 6). Keeps the last successfully
# published invitation so a Sheets outage/invalid edit can never blank the site.
# On Vercel serverless, the default filesystem store is per-instance/ephemeral,
# so provide a durable Upstash KV (formerly Vercel KV) endpoint to persist across
# cold starts and deployments. Both are optional; without KV the filesystem
# store under SNAPSHOT_DIR is used (durable on a persistent filesystem).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Directory for the filesystem snapshot fallback. Default ".data".
SNAPSHOT_DIR=.data
